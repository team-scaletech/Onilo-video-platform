{
  "name": "onilo-interactive-video-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist-lib/onilo-player.js",
  "module": "./dist-lib/onilo-player.js",
  "types": "./dist-lib/types/player/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/player/index.d.ts",
      "import": "./dist-lib/onilo-player.js"
    },
    "./style.css": "./dist-lib/onilo-player.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@vidstack/react": "^1.11.23",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.25",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.9.6",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.9.6"
  }
}
